# ---------------------------------------------------------------------------
# Sao chep file nay thanh `.env` roi dien gia tri that.
# KHONG commit file `.env` len git.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Local development dung SQLite.
# Khi chuyen sang PostgreSQL/Supabase: doi provider trong prisma/schema.prisma
# thanh "postgresql" va dat DATABASE_URL dang:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DATABASE_URL="file:./dev.db"

# --- Thong tin cong khai cua website --------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_TEACHER_NAME="[Tên thầy]"
NEXT_PUBLIC_TEACHER_TITLE="[Chức danh]"
NEXT_PUBLIC_PHONE_NUMBER="[Số điện thoại]"
NEXT_PUBLIC_ZALO_URL="[Zalo URL]"
NEXT_PUBLIC_CONTACT_EMAIL="[Email]"
NEXT_PUBLIC_FACEBOOK_URL="[Facebook URL]"
NEXT_PUBLIC_YOUTUBE_URL="[YouTube URL]"
NEXT_PUBLIC_ADDRESS="[Địa chỉ]"
NEXT_PUBLIC_TRAINING_AREA="[Khu vực đào tạo]"
NEXT_PUBLIC_GOOGLE_MAPS_URL="[Google Maps URL]"
NEXT_PUBLIC_CENTER_NAME="[Tên trung tâm]"
NEXT_PUBLIC_CONTACT_HOURS="[Thời gian liên hệ]"

# Kinh nghiem giang day - luu dang NHAN CHU, khong luu so.
# Neu du lieu that la mot uoc luong ("gan 20 nam") thi giu nguyen dang do,
# KHONG lam tron thanh con so tuyet doi ("20 nam").
NEXT_PUBLIC_EXPERIENCE_LABEL="Gần 20 năm"

# Nhom hoc vien thay da truc tiep huong dan.
# De o day de doi cach goi ma khong phai sua component nao.
NEXT_PUBLIC_STUDENT_GROUPS="học viên hệ dân sự và hệ Công an"
NEXT_PUBLIC_STUDENT_GROUPS_SHORT="học viên dân sự và Công an"

# --- Tai khoan quan tri (dung cho seed va dang nhap) ----------------------
# Doi mat khau truoc khi trien khai that. Mat khau duoc hash bang bcrypt
# truoc khi luu vao database - khong bao gio luu dang plain text.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Chuoi bi mat de ky session cookie. Toi thieu 32 ky tu.
# Tao nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# --- Analytics (tuy chon - de trong thi website van chay binh thuong) -----
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=""
NEXT_PUBLIC_ENABLE_FACEBOOK_PIXEL="false"
GOOGLE_SITE_VERIFICATION=""

# --- Hien thi nhan "Noi dung mau" tren testimonial placeholder ------------
# Mac dinh: bat o development, tat o production.
NEXT_PUBLIC_SHOW_PLACEHOLDER_BADGE=""
