# ---------------------------------------------------------------------------
# Sao chep file nay thanh `.env` roi dien gia tri that.
# KHONG commit file `.env`. KHONG dan secret that vao file .env.example nay.
# Tren Netlify: khai bao cac bien nay o Site settings > Environment variables.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL / Neon) -----------------------------------------
# Lay chuoi ket noi tu Neon (Dashboard > Connection Details).
# Dung POOLED connection (host co "-pooler") cho runtime serverless:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
#
# LUU Y: lenh migration (prisma migrate deploy) nen dung chuoi DIRECT (khong
# pooler) neu Neon yeu cau. Neu chi co 1 chuoi, ban pooled van chay duoc migrate.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Bao mat & quan tri ---------------------------------------------------
# Chuoi bi mat ky session cookie (>= 32 ky tu). Tao nhanh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Tai khoan quan tri dau tien (dung boi: npm run admin:create).
# Neu de trong ADMIN_PASSWORD, script se tu sinh mat khau manh va in 1 lan.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="doi-thanh-mat-khau-manh-toi-thieu-12-ky-tu"
# ADMIN_NAME="Quản trị viên"   # tuy chon

# --- Thong tin cong khai cua website --------------------------------------
# URL that sau khi deploy (dung cho canonical, OG, sitemap). Vi du:
# NEXT_PUBLIC_SITE_URL="https://thay-tung-lai-xe.netlify.app"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Ten thay: chi dien TEN, website tu them tien to "Thầy" (tranh ghi "Thầy Tùng"
# se thanh "Thầy Thầy Tùng").
NEXT_PUBLIC_TEACHER_NAME="Tùng"
NEXT_PUBLIC_TEACHER_TITLE="Giáo viên dạy thực hành lái xe"
NEXT_PUBLIC_PHONE_NUMBER="0967569733"
NEXT_PUBLIC_ZALO_URL="https://zalo.me/0967569733"
NEXT_PUBLIC_CONTACT_EMAIL="[Email]"
NEXT_PUBLIC_FACEBOOK_URL="[Facebook URL]"
NEXT_PUBLIC_YOUTUBE_URL="[YouTube URL]"
NEXT_PUBLIC_ADDRESS="[Địa chỉ]"
NEXT_PUBLIC_TRAINING_AREA="TP. Thủ Đức và các quận lân cận, TP.HCM"
NEXT_PUBLIC_GOOGLE_MAPS_URL="[Google Maps URL]"
NEXT_PUBLIC_CENTER_NAME="[Tên trung tâm]"
NEXT_PUBLIC_CONTACT_HOURS="7:00 - 20:00 hằng ngày"

# Kinh nghiem giang day - luu dang NHAN CHU, khong lam tron thanh so.
NEXT_PUBLIC_EXPERIENCE_LABEL="Gần 20 năm"

# Nhom hoc vien thay da truc tiep huong dan.
NEXT_PUBLIC_STUDENT_GROUPS="học viên hệ dân sự và hệ Công an"
NEXT_PUBLIC_STUDENT_GROUPS_SHORT="học viên dân sự và Công an"

# --- Preview / demo -------------------------------------------------------
# Dat "true" tren ban gui Thay Tung xem de CHAN cong cu tim kiem index.
# Khi len chinh thuc thi doi thanh "" (rong) hoac "false".
NEXT_PUBLIC_NOINDEX="true"

# --- Analytics (tat o preview) --------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=""
NEXT_PUBLIC_ENABLE_FACEBOOK_PIXEL="false"
GOOGLE_SITE_VERIFICATION=""

# --- Hien thi nhan "Noi dung mau" tren testimonial placeholder ------------
# Mac dinh: bat o development, tat o production.
NEXT_PUBLIC_SHOW_PLACEHOLDER_BADGE=""
